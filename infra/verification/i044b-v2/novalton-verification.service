[Unit]
Description=Novalton fixed verification foundation (I-044B v2)
After=network.target

[Service]
Type=exec
User=novalton-verify
Group=novalton-verify
SupplementaryGroups=novalton-verify-ipc
ExecStart=/opt/novalton-verification/i044b-v2/runtime/bin/python3.13 -I -S -B /opt/novalton-verification/i044b-v2/worker/worker.py
WorkingDirectory=/
UMask=0077
RuntimeDirectory=novalton-verification
RuntimeDirectoryMode=0711
Delegate=cpu memory pids
DelegateSubgroup=supervisor
CPUQuota=200%
MemoryMax=1280M
MemorySwapMax=0
TasksMax=48
LimitCORE=0
LimitNOFILE=128
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=no
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/novalton-verification
InaccessiblePaths=-/run/docker.sock -/run/containerd -/run/dbus -/run/user
KillMode=control-group
TimeoutStopSec=3s
SendSIGKILL=yes
Restart=on-failure
RestartSec=1s
StandardInput=null
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10

[Install]
WantedBy=multi-user.target
