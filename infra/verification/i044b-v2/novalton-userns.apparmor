# No abstractions/includes: reviewed policy bytes are the complete authority.
# CAP_SYS_ADMIN here is an LSM permission, not a host capability grant.
@{pid}=[0-9]*
profile novalton-i044b-userns /opt/novalton-verification/i044b-v2/userns-helper flags=(attach_disconnected,mediate_deleted) {
  userns create,
  capability sys_admin,
  capability sys_resource,
  /opt/novalton-verification/i044b-v2/userns-helper mr,
  /proc/@{pid}/cgroup r,
  /proc/@{pid}/attr/current r,
  /proc/@{pid}/{uid_map,gid_map,setgroups} w,
  /proc/@{pid}/ns/user r,
  # AppArmor resolves the opened anonymous nsfs inode as its filesystem root.
  / r,
  /proc/sys/user/max_user_namespaces w,
  /sys/fs/cgroup/**/run-[0-9a-f]*/cgroup.procs w,
  mount options=(rprivate) -> /,
  mount fstype=proc options=(rw,nosuid,nodev,noexec) -> /proc/,
  unix (getopt) type=seqpacket,
  unix (send, receive) type=seqpacket peer=(label=unconfined),
  signal (receive) peer=unconfined,
  signal (send) set=(chld) peer=unconfined,
  signal (send, receive) peer=novalton-i044b-userns,
}

# Attached to a dedicated immutable dynamic loader, not the service Python.
# The only executable allowed after namespace construction is the probe Python.
profile novalton-i044a-bwrap /opt/novalton-verification/i044b-v2/bwrap-loader flags=(attach_disconnected,mediate_deleted) {
  userns create,
  capability sys_admin,
  capability setuid,
  capability setgid,
  capability setpcap,
  capability sys_chroot,
  capability net_admin,
  network netlink raw,
  /opt/novalton-verification/i044b-v2/bwrap-loader mr,
  /opt/novalton-verification/i044b-v2/bwrap mr,
  /opt/novalton-verification/i044b-v2/rootfs/** mr,
  /opt/novalton-verification/i044a-v2/bwrap mr,
  /opt/novalton-verification/i044a-v2/rootfs/** mr,
  /opt/novalton-verification/i044a-v2/seccomp.bpf r,
  /var/lib/novalton-verification/snapshot-[0-9a-f]*/** r,
  /{,oldroot/}proc/** r,
  /{,oldroot/}proc/@{pid}/{uid_map,gid_map,setgroups} w,
  /{,oldroot/}dev/{null,zero,random,urandom,tty} rw,
  /tmp/ rw,
  / rw,
  /newroot/** rw,
  /tmp/** rw,
  /oldroot/ r,
  /runtime/** mr,
  /runtime/bin/python3.13 ix,
  /usr/lib/x86_64-linux-gnu/** mr,
  /lib64/ld-linux-x86-64.so.2 mr,
  /source/** r,
  /scratch/** rw,
  # All mounts require capabilities owned by the newly created user namespace.
  # AppArmor's path mediation remains a second restriction on trusted setup.
  mount options=(rslave) -> /,
  mount options=(rprivate) -> /oldroot/,
  mount options=(rbind) -> /newroot/,
  mount options=(rbind) -> /tmp/newroot/,
  mount fstype=tmpfs -> /tmp/,
  mount fstype=tmpfs -> /newroot/{dev,scratch}/,
  mount fstype=proc -> /newroot/proc/,
  mount options=(bind) /oldroot/dev/{null,zero,random,urandom,tty} -> /newroot/dev/{null,zero,random,urandom,tty},
  mount options=(rbind) /oldroot/opt/novalton-verification/i044a-v2/rootfs/ -> /newroot/,
  mount options=(rbind) /oldroot/var/lib/novalton-verification/snapshot-[0-9a-f]*/ -> /newroot/source/,
  remount options=(ro,bind) /newroot{,/**},
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
  umount /{oldroot/,},
  unix (create, getopt, getattr, shutdown) type=stream,
  unix (send, receive) type=stream peer=(label=novalton-i044a-bwrap),
  unix (create, getopt, getattr, shutdown) type=seqpacket addr=none,
  unix (send, receive) type=seqpacket addr=none peer=(label=novalton-i044a-bwrap),
  signal (receive) peer=unconfined,
  signal (send) set=(chld) peer=unconfined,
  signal (send, receive) peer=novalton-i044a-bwrap,
  ptrace (read, readby) peer=novalton-i044a-bwrap,
}
