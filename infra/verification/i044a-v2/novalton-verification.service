[Unit]
Description=Novalton fixed repository verification worker (I-044A)
Requires=var-lib-novalton\x2dverification.mount
After=var-lib-novalton\x2dverification.mount
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=exec
User=novalton-verify
Group=novalton-verify
SupplementaryGroups=novalton-verify-ipc
ExecStart=/usr/bin/env -i /opt/novalton-verification/i044a-v2/rootfs/lib64/ld-linux-x86-64.so.2 --library-path /opt/novalton-verification/i044a-v2/rootfs/usr/lib/x86_64-linux-gnu /opt/novalton-verification/i044a-v2/rootfs/runtime/bin/python3.13 -I -S -B /opt/novalton-verification/i044a-v2/worker/i044a.py
WorkingDirectory=/
UMask=0077
RuntimeDirectory=novalton-verification
RuntimeDirectoryMode=0711
Delegate=cpu memory pids
DelegateSubgroup=supervisor
CPUQuota=200%
MemoryMax=1280M
MemorySwapMax=0
TasksMax=48
LimitCORE=0
LimitNOFILE=128
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
# Full proc visibility for new PID-namespace proc mounts. The root-only parent
# is not traversable by this UID, including after entering a child user namespace.
BindPaths=/proc/1/root/proc:/run/novalton-verification-proc/full
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=no
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/novalton-verification
BindReadOnlyPaths=/var/lib/novalton-verification/source:/run/novalton-verification/source
InaccessiblePaths=-/run/docker.sock -/run/containerd -/run/dbus -/run/user
KillMode=control-group
TimeoutStopSec=3s
SendSIGKILL=yes
Restart=on-failure
RestartSec=1s
StandardInput=null
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10

[Install]
WantedBy=multi-user.target
