# Novalton OS local development configuration.
# These values are non-production defaults; copy this file to .env before use.
NOVALTON_ENV=development
NOVALTON_LOG_LEVEL=INFO

# Next.js server-side API connection (never exposed through NEXT_PUBLIC_*)
NOVALTON_API_BASE_URL=http://127.0.0.1:8000
NOVALTON_TENANT_ID=89cfc055-366e-5bcb-b65f-4f367185bf6d
NOVALTON_WORKSPACE_ID=b640b64f-8e55-53e8-a5b2-3beff9d5af82

# PostgreSQL
POSTGRES_DB=novalton
POSTGRES_USER=novalton
POSTGRES_PASSWORD=novalton_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://novalton:novalton_dev_only@localhost:5432/novalton

# Explicit local bootstrap scope (stable UUIDs and routing slugs)
NOVALTON_BOOTSTRAP_TENANT_ID=89cfc055-366e-5bcb-b65f-4f367185bf6d
NOVALTON_BOOTSTRAP_TENANT_NAME=Local Tenant
NOVALTON_BOOTSTRAP_TENANT_SLUG=tenant_local
NOVALTON_BOOTSTRAP_WORKSPACE_ID=b640b64f-8e55-53e8-a5b2-3beff9d5af82
NOVALTON_BOOTSTRAP_WORKSPACE_NAME=Default Workspace
NOVALTON_BOOTSTRAP_WORKSPACE_SLUG=workspace_default

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# Optional OpenAI-compatible provider (no provider or model is selected by default)
NOVALTON_OPENAI_COMPATIBLE_PROVIDER_ID=openrouter
NOVALTON_OPENAI_COMPATIBLE_BASE_URL=https://provider.example/v1
NOVALTON_OPENAI_COMPATIBLE_API_KEY=replace-with-provider-key
# Enable only when the configured endpoint exposes the OpenRouter-style /models schema.
NOVALTON_OPENROUTER_CATALOG_ENABLED=false
# Exact entries use provider_id::provider_model_id. Leave empty until canonical live IDs
# for DeepSeek V4 Flash Free and NVIDIA Nemotron 3 Ultra Free have been verified.
NOVALTON_MODEL_CATALOG_FREE_ALLOWLIST=
NOVALTON_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
NOVALTON_PROVIDER_READ_TIMEOUT_SECONDS=30
NOVALTON_PROVIDER_WRITE_TIMEOUT_SECONDS=10
NOVALTON_PROVIDER_POOL_TIMEOUT_SECONDS=5
NOVALTON_PROVIDER_MAX_RESPONSE_BYTES=1048576
NOVALTON_MODEL_OUTPUT_TOKEN_SAFETY_CEILING=65536
