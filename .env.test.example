# Novalton OS isolated test configuration. Copy to the ignored .env.test before DB-backed tests.
# These PostgreSQL credentials are placeholders and will not authenticate. Replace both URLs with
# the same URL for novalton_test, using the trusted local Compose/development role unless you
# deliberately configured a separate local role. Keep the database name novalton_test.
NOVALTON_ENV=test
DATABASE_URL=postgresql://replace-with-local-postgres-user:replace-with-local-postgres-password@localhost:5432/novalton_test
NOVALTON_TEST_DATABASE_URL=postgresql://replace-with-local-postgres-user:replace-with-local-postgres-password@localhost:5432/novalton_test
